<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    
    <changeSet id="2026-02-01--001-employee" author="nvoronov">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="employee"/>
            </not>
        </preConditions>
        <createTable tableName="employee">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="photo_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rented_place" type="BIGINT">
                <constraints foreignKeyName="fk_place_id"
                referencedTableName="place"
                referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2026-02-07--001-employee-password" author="nvoronov">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="employee"/>
            <not>
                <columnExists tableName="employee" columnName="password"/>
            </not>
        </preConditions>
        <addColumn tableName="employee">
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

<changeSet id="2026-02-07--002-employee-username" author="nvoronov">
<preConditions onFail="MARK_RAN">
    <tableExists tableName="employee"/>
    <not>
        <columnExists tableName="employee" columnName="username"/>
    </not>
</preConditions>
<addColumn tableName="employee">
    <column name="username" type="VARCHAR(100)">
        <constraints nullable="false" unique="true"/>
    </column>
</addColumn>
</changeSet>
</databaseChangeLog>